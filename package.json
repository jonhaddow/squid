{
	"name": "squid",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync && node scripts/gen-types.ts || echo ''",
		"check": "node scripts/gen-types.ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"gen": "node scripts/gen-types.ts",
		"deploy": "npm run build && npm run deploy:ci",
		"deploy:ci": "wrangler d1 migrations apply squid --remote && wrangler deploy",
		"db:migrate:local": "wrangler d1 migrations apply squid --local",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-cloudflare": "^9.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@types/node": "^26",
		"eslint": "^10.16.0",
		"eslint-config-prettier": "^10.1.9",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.4.0",
		"vitest": "^5.1.2",
		"wrangler": "^4.169.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.1": true,
		"esbuild@0.18.20": true,
		"workerd@1.20261104.1": true
	},
	"dependencies": {
		"@fontsource/luckiest-guy": "^5.3.0"
	}
}
